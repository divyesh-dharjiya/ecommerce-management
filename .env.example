# Public URL of the deployed site — used for canonical URLs, sitemap, robots and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Admin demo gate (optional). Without it, the first visitor on each device chooses an admin passcode.
# Generate with: npm run admin:hash -- "your passcode"
# NEXT_PUBLIC_ADMIN_PASSCODE_HASH=<salt>:<hash>
# Minutes of inactivity before the admin locks itself (default 15).
# NEXT_PUBLIC_ADMIN_IDLE_MINUTES=15
